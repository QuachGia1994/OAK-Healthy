default_platform(:ios)

def apply_store_build_number(project_path)
  build_number = ENV.fetch("STORE_BUILD_NUMBER").strip
  UI.user_error!("STORE_BUILD_NUMBER must be a positive integer") unless build_number.match?(/\A[1-9]\d*\z/)
  increment_build_number(build_number: build_number, xcodeproj: project_path)
end

platform :ios do
  desc "Build and Archive the iOS App"
  lane :build do
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    gym(
      project: project_path,
      scheme: "OAKHealthy",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_ipa: true,
      skip_package_pkg: true,
      clean: true,
      destination: "generic/platform=iOS",
      archive_path: "./build/OAKHealthy.xcarchive"
    )
  end

  desc "CI build (simulator compile)"
  lane :ci_build do
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    sh("bash", "-lc", "set -o pipefail && xcodebuild -project '#{project_path}' -scheme OAKHealthy -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' clean build")
  end

  desc "CI test (simulator + coverage)"
  lane :ci_test do
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    result_path = File.expand_path("../build/TestResults.xcresult", __dir__)
    sh("rm -rf '#{result_path}'")
    sh("bash", "-lc", "set -o pipefail && xcodebuild -project '#{project_path}' -scheme OAKHealthy -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -enableCodeCoverage YES -resultBundlePath '#{result_path}' clean test")
  end

  desc "Upload build to TestFlight"
  lane :beta do
    is_base64 = (ENV["APP_STORE_CONNECT_KEY_IS_BASE64"] || "false") == "true"
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
      is_key_content_base64: is_base64
    )
    match(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    apply_store_build_number(project_path)
    gym(
      project: project_path,
      scheme: "OAKHealthy",
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      export_method: "app-store",
      xcargs: "CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES"
    )
    upload_to_testflight(api_key: api_key)
  end

  desc "Submit the already-tested TestFlight build to App Store review"
  lane :release do
    is_base64 = (ENV["APP_STORE_CONNECT_KEY_IS_BASE64"] || "false") == "true"
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
      is_key_content_base64: is_base64
    )
    build_number = ENV.fetch("STORE_BUILD_NUMBER").strip
    app_version = ENV.fetch("STORE_VERSION").strip
    UI.user_error!("STORE_BUILD_NUMBER must be a positive integer") unless build_number.match?(/\A[1-9]\d*\z/)
    UI.user_error!("STORE_VERSION must be set for production promotion") if app_version.empty?
    upload_to_app_store(
      api_key: api_key,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: true,
      skip_screenshots: true,
      skip_metadata: true,
      force: true
    )
  end
end
