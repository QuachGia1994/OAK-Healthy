default_platform(:ios)

platform :ios do
  desc "Build and Archive the iOS App"
  lane :build do
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    gym(
      project: project_path,
      scheme: "OAKHealthy",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_ipa: true,
      skip_package_pkg: true,
      clean: true,
      destination: "generic/platform=iOS",
      archive_path: "./build/OAKHealthy.xcarchive"
    )
  end

  desc "CI build (simulator compile)"
  lane :ci_build do
    project_path = File.expand_path("../OAKHealthy.xcodeproj", __dir__)
    sh("set -o pipefail && xcodebuild -project '#{project_path}' -scheme OAKHealthy -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' clean build")
  end
end
