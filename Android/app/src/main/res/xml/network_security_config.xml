            <pin digest="SHA-256">JSMzE0c3l4ANxkt4ujPT/g5nuTYA2TapP120S5u7Dqo=</pin>
            <pin digest="SHA-256">W2rgt8K5b0wM7UuV0BnXmBm1G3bN0bL4K8D9F2e1Z8=</pin>
            <!-- DigiCert (GitHub) -->
            <pin digest="SHA-256">x4QzPSC8N0lG45ochKb6AD6eLk7LbqJQ1aZ2dH5n1cA=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
