<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ponytail: block cleartext for Firebase and GitHub domains.
         Certificate pinning: capture real SPKI hashes from a running app
         and add a <pin-set> block here before production release. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebasedatabase.app</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">github.com</domain>
    </domain-config>
</network-security-config>
