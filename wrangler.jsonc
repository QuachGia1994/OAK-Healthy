{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oak-healthy",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "healthy.oakgatekeeper.uk", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/s/*", "/c/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "oak-healthy", "database_id": "eeb4ba1d-667c-41b0-8ca6-7402b4879d4d" }
  ],
  "durable_objects": { "bindings": [{ "name": "CLOCK", "class_name": "ReminderClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderClock"] }],
  "observability": { "enabled": true }
}